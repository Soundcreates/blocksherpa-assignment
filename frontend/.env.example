# Set this to the address printed by `npm run deploy:amoy` in ../blockchain.
VITE_PROPERTY_REGISTRY_ADDRESS=0xYourDeployedAmoyRegistryAddress

# Existing REChain frontend variables remain supported.
VITE_API_BASE_URL=http://localhost:4000
VITE_ENABLE_AI_HUB=true

# Grok and Firecrawl secrets stay server-side on Render, or can be entered in the AI Hub.
# Never expose GROK_API_KEY through a VITE_* variable on Vercel.
